# Copy to .env and fill in. .env is gitignored — never commit real keys.

# Required for the Gemini narration backend. Get one at
# https://aistudio.google.com/apikey
GEMINI_API_KEY=

# gemini | ollama | auto (default: prefers Gemini if GEMINI_API_KEY is set,
# else falls back to a local Ollama server)
SATQUERY_VLM_BACKEND=auto

# Only used by the Ollama backend, and only if you're running it yourself.
# SATQUERY_VLM_MODEL=qwen2.5vl:7b
# OLLAMA_BASE_URL=http://localhost:11434

# Comma-separated allowed origins for the deployed frontend, e.g.
# SATQUERY_CORS_ORIGINS=https://satquery.vercel.app
